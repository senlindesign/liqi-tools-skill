{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Liqi tool mention",
  "type": "object",
  "required": [
    "mention_id",
    "tool_name_raw",
    "tool_name_canonical",
    "tool_type",
    "creator",
    "use_case",
    "mention_kind",
    "evidence",
    "evidence_heading",
    "source_interview_id",
    "source_url",
    "confidence"
  ],
  "properties": {
    "mention_id": {"type": "string"},
    "tool_name_raw": {"type": "string"},
    "tool_name_canonical": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "tool_type": {"type": "string"},
    "creator": {"type": "string"},
    "creator_roles": {"type": "array", "items": {"type": "string"}},
    "use_case": {"type": "string"},
    "when_to_use": {"type": "string"},
    "why_recommended": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "mention_kind": {
      "enum": ["recommended", "used", "formerly_used", "not_recommended", "editorial"]
    },
    "evidence": {"type": "string"},
    "evidence_heading": {"type": "string"},
    "source_interview_id": {"type": "string"},
    "source_url": {"type": "string", "format": "uri"},
    "confidence": {"enum": ["high", "medium", "low"]},
    "review_status": {"enum": ["machine_extracted", "human_verified"]}
  },
  "additionalProperties": false
}
